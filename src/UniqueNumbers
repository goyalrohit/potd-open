class Solution {
    public ArrayList<ArrayList<Integer>> combinationSum(int n, int k) {
        // code here
        ArrayList<ArrayList<Integer>> result = new ArrayList<>();
        combinationSum(n, k, 1, 0, new ArrayList<>(), result);
        return result;
    }
    
    private void combinationSum(int n, int k, int start, int sum, ArrayList<Integer> current, ArrayList<ArrayList<Integer>> list) {
        if (current.size() == k) {
            if (sum == n) {
                list.add(new ArrayList<>(current));
            }
            return;
        }
        for (int i = start; i <= 9; i++) {
            current.add(i);
            combinationSum(n, k, i + 1, sum + i, current, list);
            current.remove(current.size() - 1);
        }
    }
}

//Time Complexity: O(9^n)
//Space Complexity: O(K)
